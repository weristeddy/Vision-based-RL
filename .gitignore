**/.codex

# Generated outputs live here; selected figures are promoted to reports/. Only the
# camera calibration is tracked: the real-robot data and the feature-analysis
# images run to gigabytes, and GitHub rejects any file over 100 MB.
artifacts/**
!artifacts/.gitkeep
!artifacts/deployment/
!artifacts/deployment/intrinsics/
!artifacts/deployment/intrinsics/**
!artifacts/deployment/extrinsics/
!artifacts/deployment/extrinsics/**

# Trained policies may be copied here locally or fetched from W&B on demand.
# Exported ONNX graphs are the same weights in the deployable format, so they
# live beside their .pt and are ignored on the same grounds -- 90 MB each, and
# downloadable from the run on W&B (fetch_policies).
ckpts/**/*.pt
ckpts/**/*.onnx

# Container images are build products; recipes remain tracked.
*.sif
*.sif.prev

# Apptainer build scratch. Pointed here rather than at $HOME, whose quota is
# what usually fails the build: the base image, the wheel cache and the baked
# backbones all land in these. Safe to delete once rl.sif exists.
.apptainer-tmp
.apptainer-cache

# W&B-generated sweep state
*.sweep_path.txt

.agents
CLAUDE.md

# Development-host pretrained backbones (the image bakes /opt/vbrl-models).
.models

# System identification recordings and fit output
artifacts/deployment/sysid_*.npz
artifacts/sysid/
