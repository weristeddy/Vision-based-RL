      <geom name="push_chain_link1_ring_visual" class="visual" type="cylinder" size="0.015 0.011" pos="0.04375 0 -0.00395" />
      <body name="push_chain_link0" pos="-0.07875 0 0">
        <joint name="push_chain_hinge0" class="hinge" pos="0.035 0 0" axis="0 0 -1" />
        <inertial pos="0.0026297 0 -0.00111252" mass="0.0223267" fullinertia="3.18248e-06 1.32364e-05 1.33572e-05 0 7.33625e-07 0" />
        <geom name="push_chain_link0_body_collision" class="collision" type="box" size="0.02625 0.015 0.015" pos="-0.00875 0 0" />
        <geom name="push_chain_link0_lower_collision" class="collision" type="box" size="0.00875 0.015 0.01105" pos="0.02625 0 -0.00395" />
