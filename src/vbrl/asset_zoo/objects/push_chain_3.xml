<!--
  Pushing chain with 3 links, extendable design: every middle part carries a peg
  (top plate with rounded tip, 22.5-30 mm) at its -x end and a ring (0-22.1 mm) at its
  +x end, so any number of identical middle parts join; one end part has only the ring,
  the other only the peg.

    link0 (ring end) - link1 (middle) - link2 (peg end)

  Lengths: end parts 70 mm from the free end to the pin, middle parts
  87.5 mm between their pins, all 30 mm wide and 30 mm high, every full-height block
  52.5 mm long and starting 17.5 mm from its pin (joint stop about 97-99 deg).
  Peg (D7) and holes (D8, 1 mm clearance) are not geoms: the hinge replaces them.
  Mass, centre of mass and full inertia are computed from the solid parts (pegs
  included, holes removed) at 341.1 kg/m^3, the effective density of the earlier
  end link. TODO: weigh the printed parts and scale mass and inertia.
  Root body is the centre link (link1, free joint). Body frames sit in the middle of
  each link's segment, at mid-height. Joint angle convention: hinge_i = yaw(link i+1) -
  yaw(link i). Generated; keep the parts in step when editing by hand.
-->
<mujoco model="push_chain">
  <compiler angle="radian" />

  <default>
    <default class="collision">
      <geom
        contype="1"
        conaffinity="1"
        group="5"
        rgba="0 0 0 0"
        solref="0.01 1"
        solimp="0.95 0.99 0.0002 0.5 2"
      />
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" mass="0" material="push_chain_red" />
    </default>
    <default class="hinge">
      <!-- range +-97 deg; limit stiffer than MuJoCo's default (0.02 s), the
           stiffest that stays stable at the 5 ms timestep.
           frictionloss: estimate for printed PLA on PLA (mu ~0.45) with 1 mm peg
           clearance. Unloaded the joint has no contact, so friction comes only from
           the force that drags the other links (0.05-0.2 N) acting at the 3.5 mm
           peg radius: 0.08-0.3 mN m. Nominal 0.2 mN m, randomized in training.
           damping: a dry joint has almost none; kept small for numerical stability. -->
      <joint
        type="hinge"
        limited="true"
        range="-1.69297 1.69297"
        damping="0.0001"
        frictionloss="0.0002"
        armature="1e-05"
        solreflimit="0.01 1"
        solimplimit="0.95 0.99 0.001 0.5 2"
      />
    </default>
  </default>

  <asset>
    <!-- same red as the Push-T object -->
    <material
      name="push_chain_red"
      rgba="0.7607843137254902 0.07450980392156863 0.08627450980392157 1"
    />
  </asset>

  <worldbody>
    <body name="push_chain_link1">
      <freejoint name="push_chain_joint" />
      <inertial pos="0.0060116 0 -1.932e-05" mass="0.0248558" fullinertia="3.67124e-06 2.00703e-05 2.00072e-05 0 2.01157e-06 0" />
      <geom name="push_chain_link1_plate_collision" class="collision" type="box" size="0.00875 0.015 0.00375" pos="-0.035 0 0.01125" />
      <geom name="push_chain_link1_plate_tip_collision" class="collision" type="cylinder" size="0.015 0.00375" pos="-0.04375 0 0.01125" />
      <geom name="push_chain_link1_body_collision" class="collision" type="box" size="0.02625 0.015 0.015" pos="0 0 0" />
      <geom name="push_chain_link1_lower_collision" class="collision" type="box" size="0.00875 0.015 0.01105" pos="0.035 0 -0.00395" />
      <geom name="push_chain_link1_ring_collision" class="collision" type="cylinder" size="0.015 0.01105" pos="0.04375 0 -0.00395" />
      <geom name="push_chain_link1_plate_visual" class="visual" type="box" size="0.00875 0.015 0.00375" pos="-0.035 0 0.01125" />
      <geom name="push_chain_link1_plate_tip_visual" class="visual" type="cylinder" size="0.015 0.0037" pos="-0.04375 0 0.01125" />
